<view class="page">
  <view class="section">
    <text class="section-title">修改密码</text>

    <view class="field">
      <text class="label">当前密码</text>
      <view class="input-row">
        <input class="input" password="{{!showCurrent}}" placeholder="请输入当前密码" value="{{currentPassword}}" data-field="currentPassword" bindinput="handleInput" />
        <text class="toggle" bindtap="toggleCurrent">{{showCurrent ? '隐藏' : '显示'}}</text>
      </view>
    </view>

    <view class="field">
      <text class="label">新密码</text>
      <view class="input-row">
        <input class="input" password="{{!showNew}}" placeholder="请输入新密码（至少 8 位）" value="{{newPassword}}" data-field="newPassword" bindinput="handleInput" />
        <text class="toggle" bindtap="toggleNew">{{showNew ? '隐藏' : '显示'}}</text>
      </view>
    </view>

    <view class="field">
      <text class="label">确认新密码</text>
      <view class="input-row">
        <input class="input" password="{{!showConfirm}}" placeholder="再次输入新密码" value="{{confirmPassword}}" data-field="confirmPassword" bindinput="handleInput" />
        <text class="toggle" bindtap="toggleConfirm">{{showConfirm ? '隐藏' : '显示'}}</text>
      </view>
    </view>

    <button class="btn primary" bindtap="handleSubmit" loading="{{loading}}" disabled="{{loading}}">确认修改</button>
  </view>
</view>
