<view class="page">
  <view wx:if="{{sent}}" class="state">
    <text class="state-title">重置邮件已发送</text>
    <text class="state-text">请查收邮箱（包括垃圾邮件），点击邮件中的重置链接，或复制其中的 token 进入下一步。</text>
    <button class="btn primary" bindtap="goReset">去重置密码</button>
    <button class="btn text" bindtap="goBack">返回登录</button>
  </view>

  <block wx:else>
    <view class="section">
      <text class="section-title">忘记密码</text>
      <text class="hint">输入注册邮箱，我们将发送重置密码邮件</text>

      <view class="field">
        <input class="input" type="text" placeholder="注册邮箱" value="{{email}}" bindinput="handleInput" />
      </view>

      <button class="btn primary" bindtap="handleSubmit" loading="{{loading}}" disabled="{{loading}}">发送重置邮件</button>
    </view>
  </block>
</view>
