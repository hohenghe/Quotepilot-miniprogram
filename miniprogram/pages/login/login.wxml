<view class="page">
  <view wx:if="{{mode === 'home'}}" class="brand">
    <image class="brand-logo" src="/images/zhermai-seller-logo.svg" mode="aspectFit" />
  </view>

  <view wx:if="{{mode === 'register'}}" class="distribution-choice">
    <text class="distribution-title">是否支持铺货（必选）</text>
    <radio-group bindchange="handleDistributionChange">
      <label><radio value="yes" checked="{{supportsDistribution === true}}" disabled="{{loading}}" color="#2563eb" />是</label>
      <label><radio value="no" checked="{{supportsDistribution === false}}" disabled="{{loading}}" color="#2563eb" />否</label>
    </radio-group>
  </view>

  <block wx:if="{{mode === 'home'}}">
    <button wx:if="{{wechatBoundReady}}" class="btn phone-login" open-type="getPhoneNumber" bindgetphonenumber="handleWechatLogin" loading="{{loading}}" disabled="{{loading}}">微信快捷登录</button>
    <button wx:else class="btn phone-login" open-type="getPhoneNumber" bindgetphonenumber="handleWechatLogin" loading="{{loading}}" disabled="{{loading}}">手机号快捷登录</button>
    <button class="btn secondary" bindtap="goAccountLogin">账号登录</button>
  </block>

  <block wx:elif="{{mode === 'wechatUnbound'}}">
    <text class="unbound-title">登录账号</text>
    <text class="hint">手机号快捷登录会直接创建或登录卖家账号，无需注册邮箱。</text>
    <button class="btn primary" bindtap="goWechatBind">绑定已有账号</button>
    <button class="btn text" bindtap="goHome">返回</button>
  </block>

  <block wx:elif="{{mode === 'accountLogin'}}">
    <view class="form">
      <input class="input" type="text" placeholder="邮箱 / 登录账号" value="{{identifier}}" data-field="identifier" bindinput="handleInput" />
      <view class="pwd-row">
        <input class="input" password="{{!showPwd}}" placeholder="密码" value="{{password}}" data-field="password" bindinput="handleInput" />
        <view class="pwd-toggle" bindtap="togglePwd" aria-label="切换密码显示">
          <view class="eye-icon {{showPwd ? 'open' : 'closed'}}"></view>
        </view>
      </view>
      <button class="btn primary" bindtap="handleAccountLogin" loading="{{loading}}" disabled="{{loading}}">登录</button>
      <button class="btn text" bindtap="goForgotPassword">忘记密码？</button>
      <button class="btn text" bindtap="goRegister">注册账号</button>
      <button class="btn text" bindtap="goHome">返回</button>
    </view>
  </block>

  <block wx:elif="{{mode === 'bind'}}">
    <view class="form">
      <text class="hint bind-hint">请输入卖家登录账号和密码</text>
      <input class="input" type="text" placeholder="邮箱 / 登录账号" value="{{identifier}}" data-field="identifier" bindinput="handleInput" />
      <view class="pwd-row">
        <input class="input" password="{{!showPwd}}" placeholder="密码" value="{{password}}" data-field="password" bindinput="handleInput" />
        <view class="pwd-toggle" bindtap="togglePwd" aria-label="切换密码显示">
          <view class="eye-icon {{showPwd ? 'open' : 'closed'}}"></view>
        </view>
      </view>
      <button class="btn primary" open-type="getPhoneNumber" bindgetphonenumber="handleBind" loading="{{loading}}" disabled="{{loading}}">授权手机号并绑定邮箱</button>
      <button class="btn text" bindtap="goWechatUnbound">返回</button>
    </view>
  </block>

  <block wx:elif="{{mode === 'register'}}">
    <view class="form">
      <input class="input" type="text" placeholder="邮箱（可选）" value="{{regEmail}}" data-field="regEmail" bindinput="handleInput" />
      <view class="pwd-row">
        <input class="input" password="{{!showRegPwd}}" placeholder="密码（至少 8 位）" value="{{regPassword}}" data-field="regPassword" bindinput="handleInput" />
        <view class="pwd-toggle" bindtap="toggleRegPwd" aria-label="切换密码显示">
          <view class="eye-icon {{showRegPwd ? 'open' : 'closed'}}"></view>
        </view>
      </view>
      <view class="pwd-row">
        <input class="input" password="{{!showRegConfirm}}" placeholder="确认密码" value="{{regConfirm}}" data-field="regConfirm" bindinput="handleInput" />
        <view class="pwd-toggle" bindtap="toggleRegConfirm" aria-label="切换密码显示">
          <view class="eye-icon {{showRegConfirm ? 'open' : 'closed'}}"></view>
        </view>
      </view>
      <input class="input" placeholder="公司名称" value="{{regName}}" data-field="regName" bindinput="handleInput" />
      <view class="phone-row">
        <input class="input phone-input" type="text" placeholder="电话" value="{{regPhone}}" data-field="regPhone" bindinput="handleInput" />
        <button class="phone-authorize" open-type="getPhoneNumber" bindgetphonenumber="handleAuthorizeRegisterPhone" loading="{{authorizingRegisterPhone}}" disabled="{{authorizingRegisterPhone}}">授权手机号</button>
      </view>
      <picker mode="multiSelector" range="{{regionColumns}}" value="{{regionIndexes}}" bindchange="handleRegionChange" bindcolumnchange="handleRegionColumnChange">
        <view class="input picker">地区：{{regionDisplay}}</view>
      </picker>
      <button class="btn primary" bindtap="handleRegister" loading="{{loading}}" disabled="{{loading}}">注册</button>
      <button class="btn text" bindtap="goHome">返回</button>
    </view>
  </block>

  <block wx:elif="{{mode === 'registered'}}">
    <view class="form center">
      <text class="success-title">注册成功</text>
      <text class="registered-message">{{registeredMessage}}</text>
      <block wx:if="{{registeredEmail}}">
        <text class="hint">验证邮件已发送到</text>
        <text class="registered-email">{{registeredEmail}}</text>
        <text class="hint">验证完成后即可使用账号登录。</text>
      </block>
      <text wx:else class="hint">可直接使用手机号快捷登录。</text>
      <text wx:if="{{resendMessage}}" class="resend-message">{{resendMessage}}</text>
      <button wx:if="{{registeredEmail}}"
        class="btn primary"
        bindtap="handleResendVerification"
        loading="{{resending}}"
        disabled="{{resending || resendCooldown > 0}}"
      >{{resendBtnText}}</button>
      <button class="btn text" bindtap="goHome">返回登录</button>
    </view>
  </block>

  <button class="btn text" bindtap="continueAsGuest" disabled="{{loading}}">暂不登录，继续浏览</button>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
