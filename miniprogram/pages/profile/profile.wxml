<view class="page">
  <view class="section" bindtap="goTutorial"><text class="section-title">使用教程 · 再次查看 ›</text></view>
  <view wx:if="{{guest}}" class="section"><text>游客模式：登录后可管理店铺资料、头像、营业执照和账户安全。</text><button class="btn primary" bindtap="requestLogin">登录 / 注册</button></view>
  <view wx:if="{{loading}}" class="hint">加载中…</view>

  <block wx:elif="{{!guest}}">
    <view class="section">
      <text class="section-title">店铺资料</text>

      <view class="field">
        <text class="label">店铺名称</text>
        <input class="input" placeholder="店铺名称" value="{{storeName}}" data-field="storeName" bindinput="handleInput" />
      </view>
      <view class="field">
        <text class="label">公司名称</text>
        <input class="input" placeholder="公司名称" value="{{name}}" data-field="name" bindinput="handleInput" />
      </view>
      <view class="field">
        <text class="label">地区</text>
        <picker mode="multiSelector" range="{{regionColumns}}" value="{{regionIndexes}}" bindchange="handleRegionChange" bindcolumnchange="handleRegionColumnChange">
          <view class="input picker">{{country}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">邮箱</text>
        <input class="input" disabled value="{{email}}" />
      </view>
      <view class="field">
        <text class="label">会员号</text>
        <input class="input" disabled value="{{uid}}" />
      </view>
    </view>

    <view class="section">
      <text class="section-title">账户安全</text>

      <view class="row-item" bindtap="goChangePassword">
        <text class="row-label">修改密码</text>
        <text class="row-arrow">›</text>
      </view>

      <view class="divider"></view>

      <view class="row-item">
        <text class="row-label">主手机号</text>
        <text class="row-value">{{phone || '未绑定'}}</text>
      </view>
      <text class="row-hint">主手机号不可直接修改</text>

      <view class="divider"></view>

      <view class="row-item">
        <text class="row-label">其他绑定手机号</text>
        <text class="row-value muted">暂未开放</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">头像</text>
      <view class="upload-row">
        <image wx:if="{{avatarUrl}}" class="preview avatar" src="{{avatarUrl}}" mode="aspectFill" bindtap="previewAvatar" />
        <view wx:else class="preview avatar placeholder"></view>
        <button class="btn secondary upload-btn" bindtap="handleChooseAvatar" loading="{{uploadingAvatar}}" disabled="{{uploadingAvatar}}">上传头像</button>
      </view>
    </view>

    <view class="section">
      <text class="section-title">营业执照</text>
      <view class="upload-row">
        <image wx:if="{{licenseUrl}}" class="preview license" src="{{licenseUrl}}" mode="aspectFill" bindtap="previewLicense" />
        <view wx:else class="preview license placeholder"></view>
        <button class="btn secondary upload-btn" bindtap="handleChooseLicense" loading="{{uploadingLicense}}" disabled="{{uploadingLicense}}">上传营业执照</button>
      </view>
    </view>

    <button class="btn primary save" bindtap="handleSave" loading="{{saving}}" disabled="{{saving}}">保存</button>

    <button class="btn logout" bindtap="handleLogout">退出登录</button>
  </block>
</view>
