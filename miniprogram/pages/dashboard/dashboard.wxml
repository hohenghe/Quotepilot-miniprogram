<view class="page">
  <view class="header">
    <text class="store-name">{{storeName}}</text>
    <text class="email">{{email}}</text>
    <text class="uid">会员号 {{uid}}</text>
  </view>

  <view class="stats">
    <view class="stat">
      <text class="stat-value">{{productCount}}</text>
      <text class="stat-label">商品</text>
    </view>
    <view class="stat">
      <text class="stat-value">{{inquiryCount}}</text>
      <text class="stat-label">询盘</text>
    </view>
    <view class="stat">
      <text class="stat-value">{{pendingCount}}</text>
      <text class="stat-label">待回复</text>
    </view>
    <view class="stat">
      <text class="stat-value">{{repliedCount}}</text>
      <text class="stat-label">已回复</text>
    </view>
    <view class="stat">
      <text class="stat-value">{{scoreText}}</text>
      <text class="stat-label">店铺评分</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <view wx:elif="{{error}}" class="error">{{error}}</view>

  <view class="section menu">
    <view class="menu-item" bindtap="goProducts">
      <text class="menu-label">商品管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goInquiries">
      <text class="menu-label">询盘管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goProfile">
      <text class="menu-label">店铺资料</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goReviews">
      <text class="menu-label">评价管理</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title">最近询盘</text>
    <view wx:if="{{inquiries.length === 0}}" class="empty">暂无询盘</view>
    <view wx:for="{{inquiries}}" wx:key="id" class="inquiry" bindtap="goInquiries">
      <view class="inquiry-top">
        <text class="inquiry-email">{{item.buyer_email || '买家'}}</text>
        <text class="inquiry-status {{item.status === 'replied' ? 'replied' : 'pending'}}">{{item.status === 'replied' ? '已回复' : '待回复'}}</text>
      </view>
      <text class="inquiry-msg">{{item.raw_message}}</text>
    </view>
  </view>

  <button class="btn" bindtap="handleLogout">退出登录</button>
</view>
