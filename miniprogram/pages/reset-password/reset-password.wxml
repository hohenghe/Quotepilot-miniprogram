<view class="page">
  <view class="section">
    <text class="section-title">重置密码</text>

    <view class="field">
      <text class="label">重置 token</text>
      <input class="input" placeholder="粘贴邮件中的链接或 token" value="{{token}}" data-field="token" bindinput="handleInput" />
    </view>

    <view class="field">
      <text class="label">新密码</text>
      <view class="pwd-row">
        <input class="input" password="{{!showNew}}" placeholder="至少 8 位" value="{{newPassword}}" data-field="newPassword" bindinput="handleInput" />
        <text class="pwd-toggle" bindtap="toggleNew">{{showNew ? '隐藏' : '显示'}}</text>
      </view>
    </view>

    <view class="field">
      <text class="label">确认新密码</text>
      <view class="pwd-row">
        <input class="input" password="{{!showConfirm}}" placeholder="再次输入新密码" value="{{confirmPassword}}" data-field="confirmPassword" bindinput="handleInput" />
        <text class="pwd-toggle" bindtap="toggleConfirm">{{showConfirm ? '隐藏' : '显示'}}</text>
      </view>
    </view>

    <button class="btn primary" bindtap="handleSubmit" loading="{{loading}}" disabled="{{loading}}">重置密码</button>
  </view>
</view>
